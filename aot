-- ================== CHẠY LOADER (đã tải sẵn thì chạy ngay) ==================
local success = false

-- Chờ bản tải trước nếu chưa xong (tối đa 30 giây)
local w = 0
while not prefetchDone and w < 30 do
    task.wait(0.1)
    w += 0.1
end

if prefetched then
    local ok, err = pcall(function()
        local t2 = os.clock()
        loadstring(prefetched)()
        notify(string.format("Loader khởi chạy xong (%.1fs)", os.clock() - t2))
    end)
    if ok then
        success = true
    else
        warn("[Autoexec] Lỗi khi chạy loader: " .. tostring(err))
    end
end

-- Dự phòng: nếu tải trước thất bại thì thử tải trực tiếp như cũ
if not success then
    for attempt = 1, 3 do
        local ok, err = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        if ok then success = true break end
        warn("[Autoexec] Lần " .. attempt .. " lỗi: " .. tostring(err))
        task.wait(1)
    end
end

if success then
    notify("Hoàn tất")
else
    getgenv().VZ_JobId = nil
    notify("Tải script thất bại")
end
