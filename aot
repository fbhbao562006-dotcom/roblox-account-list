-- Giữ bản sao config để khôi phục nếu hub làm mất hoặc ghi đè
local configBackup = getgenv().TCFG

-- ================== LOADER ==================
local url = "https://api.luarmor.net/files/v4/loaders/5bfd68232034676923088ca8b6698be7.lua"
local success = false

notify("Đang tải loader...")
for attempt = 1, 5 do
    local ok, err = pcall(function()
        local t1 = os.clock()
        local src = game:HttpGet(url)
        notify(string.format("Tải xong loader (%.1fs)", os.clock() - t1))
        local t2 = os.clock()
        loadstring(src)()
        notify(string.format("Loader khởi chạy xong (%.1fs)", os.clock() - t2))
    end)
    if ok then
        success = true
        break
    end
    warn("[Autoexec] Lần " .. attempt .. " lỗi: " .. tostring(err))
    notify("Lần " .. attempt .. " lỗi, thử lại...")
    task.wait(1)
end

if success then
    notify("Loader chạy xong")
    -- Nếu hub làm mất config trong vài giây đầu thì đặt lại
    task.delay(5, function()
        if getgenv().TCFG == nil then
            getgenv().TCFG = configBackup
            warn("[Autoexec] Config bị mất, đã khôi phục")
        end
    end)
else
    getgenv().TCFG_JobId = nil
    notify("Tải script thất bại sau 5 lần thử")
end
