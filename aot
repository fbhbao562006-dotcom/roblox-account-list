-- ================== CHỐNG CHẠY TRÙNG (theo server) ==================
if getgenv().VZ_JobId == game.JobId then return end
getgenv().VZ_JobId = game.JobId

-- ================== THÔNG BÁO KÈM SỐ GIÂY ==================
local T0 = os.clock()
local function notify(t)
    local msg = string.format("[%.1fs] %s", os.clock() - T0, t)
    print("[Autoexec] " .. msg)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Autoexec", Text = msg, Duration = 4
        })
    end)
end
notify("Script bắt đầu chạy")

-- ================== GIỮ MÁY "TỈNH" LÚC KHỞI ĐỘNG (thử nghiệm) ==================
-- Triệu chứng: chạm màn hình thì load nhanh, không chạm thì chậm -> máy/Roblox đang hạ FPS khi không có thao tác.
-- Đoạn này gửi thao tác ảo nhẹ trong 45 giây đầu. Nếu không thấy khác biệt thì đặt KEEP_AWAKE = false.
local KEEP_AWAKE = true
if KEEP_AWAKE then
    task.spawn(function()
        local t0 = os.clock()
        while os.clock() - t0 < 45 do
            pcall(function()
                local VU = game:GetService("VirtualUser")
                VU:CaptureController()
                VU:ClickButton2(Vector2.new(0, 0))
            end)
            pcall(function()
                local VIM = game:GetService("VirtualInputManager")
                VIM:SendMouseMoveEvent(5, 5, game)
            end)
            task.wait(0.5)
        end
    end)
end

-- ================== TẢI TRƯỚC LOADER (chạy song song với lúc game load) ==================
local url = "https://hamsterdiwa.com/loader/aotr"
local prefetched, prefetchDone = nil, false
task.spawn(function()
    local t1 = os.clock()
    for _ = 1, 5 do
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok and type(res) == "string" and #res > 0 then
            prefetched = res
            break
        end
        task.wait(0.5)
    end
    prefetchDone = true
    notify(string.format("Tải trước loader xong (%.1fs)", os.clock() - t1))
end)

-- ================== CHẾ ĐỘ KHỞI ĐỘNG SỚM ==================
-- true  = chạy hub ngay, không chờ game load xong (hub tự khởi tạo song song với lúc game load -> nhanh hơn)
-- false = chờ game + PlayerGui sẵn sàng rồi mới chạy hub (ổn định hơn nếu bản true bị lỗi)
local EARLY_START = true

if not EARLY_START then
    -- ================== ĐỢI GAME (không chờ cứng) ==================
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end

    local Players = game:GetService("Players")
    local plr = Players.LocalPlayer
    if not plr then
        Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
        plr = Players.LocalPlayer
    end
    plr:WaitForChild("PlayerGui")
    notify("Người chơi sẵn sàng")
end

