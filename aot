-- ================== ĐỢI GAME HẾT LAG LÚC VÀO ==================
-- Game thường lag nặng vài giây đầu khi vừa vào. Nạp hub lúc đó sẽ làm hub bật chức năng rất chậm.
-- Đoạn này chờ tới khi FPS ổn định (>= 25) rồi mới tải hub, tối đa 20 giây.
local function waitStableFps(minFps, timeout)
    local start = os.clock()
    local frames, t0 = 0, os.clock()
    local conn = RunService.Heartbeat:Connect(function()
        frames += 1
    end)
    local stable = false
    while os.clock() - start < timeout do
        task.wait(1)
        local now = os.clock()
        local fps = frames / (now - t0)
        frames, t0 = 0, now
        if fps >= minFps then
            stable = true
            break
        end
    end
    conn:Disconnect()
    return stable
end

local WAIT_STABLE_FPS = false -- đổi thành true nếu muốn đợi game hết lag rồi mới tải hub
if WAIT_STABLE_FPS then
    notify("Đang đợi game ổn định...")
    local stable = waitStableFps(25, 20)
    notify(stable and "Game đã ổn định" or "Hết thời gian chờ, vẫn tải hub")
end

